# ---- Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of proxies in front of the API (Render = 1, local = 0)
TRUST_PROXY=0

# ---- Database ----
# Local docker-compose Postgres (see root docker-compose.yml)
DATABASE_URL=postgresql://pms:pms_password@localhost:5432/pms?schema=public

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# ---- Web / CORS / Cookies ----
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Defaults to true in production. Keep false for plain-http localhost.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true

# ---- Push notifications (optional) ----
# Secret header value used by the scheduled GitHub Action (min 32 chars)
CRON_SECRET=
# base64 of the Firebase service account JSON:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=
